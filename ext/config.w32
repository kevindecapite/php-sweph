// config.w32 for the swephp extension

ARG_ENABLE(
    "swephp",
    "Enable the Swiss Ephemeris PHP extension",
    "no"
);

ARG_WITH(
    "swisseph-src",
    "Path to the Swiss Ephemeris C sources",
    "no"
);

if (PHP_SWEPHP != "no") {
    var swissephDir;

    /*
     * Erwartete Struktur:
     *
     * ext/
     *   config.w32
     *   swephp.c
     *   php_swephp.h
     *   swephp_arginfo.h
     *
     * native/
     *   swisseph/
     *     swephexp.h
     *     sweodef.h
     *     sweph.c
     *     swephlib.c
     *     ...
     */
    if (PHP_SWISSEPH_SRC == "no") {
        swissephDir =
            configure_module_dirname +
            "\\..\\native\\swisseph";
    } else {
        swissephDir = PHP_SWISSEPH_SRC;
    }

    /*
     * Prüfen, ob swephexp.h verfügbar ist, und den Include-Pfad
     * für die Extension setzen.
     */
    if (!CHECK_HEADER_ADD_INCLUDE(
        "swephexp.h",
        "CFLAGS_SWEPHP",
        swissephDir
    )) {
        ERROR(
            "swephexp.h was not found in " +
            swissephDir
        );
    }

    /*
     * PHP-Extension registrieren.
     */
    EXTENSION(
        "swephp",
        "swephp.c",
        PHP_SWEPHP_SHARED
    );

    /*
     * Swiss-Ephemeris-Quellen direkt mit der Extension kompilieren.
     */
    ADD_SOURCES(
        swissephDir,
        [
            "swecl.c",
            "swedate.c",
            "swehouse.c",
            "swejpl.c",
            "swemmoon.c",
            "swemplan.c",
            "sweph.c",
            "swephlib.c"
        ].join(" "),
        "swephp"
    );

    AC_DEFINE(
        "HAVE_SWEPHP",
        1,
        "Swiss Ephemeris PHP extension support"
    );
}