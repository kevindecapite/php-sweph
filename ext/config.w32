// config.w32 for the swephp extension

ARG_WITH(
    "swephp",
    "Swiss Ephemeris support",
    "no"
);

ARG_WITH(
    "swisseph-src",
    "Path to the Swiss Ephemeris C sources",
    "no"
);

if (PHP_SWEPHP != "no") {
    var swissephDir;

    /*
     * Wenn kein eigener Pfad angegeben wurde, erwarten wir die
     * Swiss-Ephemeris-Quellen relativ zum Extension-Verzeichnis.
     *
     * Erwartete Repository-Struktur:
     *
     * ext/
     *   config.w32
     *   swephp.c
     *   php_swephp.h
     *
     * native/
     *   swisseph/
     *     swephexp.h
     *     sweph.c
     *     ...
     */
    if (PHP_SWISSEPH_SRC == "no") {
        swissephDir =
            configure_module_dirname +
            "\\..\\native\\swisseph";
    } else {
        swissephDir = PHP_SWISSEPH_SRC;
    }

    CHECK_HEADER_ADD_INCLUDE(
        "swephexp.h",
        "CFLAGS_SWEPHP",
        swissephDir
    );

    /*
     * PHP-Extension registrieren.
     */
    EXTENSION(
        "swephp",
        "swephp.c",
        PHP_SWEPHP_SHARED,
        "/I \"" + swissephDir + "\""
    );

    /*
     * Variante A:
     * Swiss-Ephemeris-C-Quelldateien direkt mit der Extension kompilieren.
     *
     * Das ist unter Windows meist einfacher als zuerst eine statische
     * libswe.lib zu bauen.
     */
    ADD_SOURCES(
        swissephDir,
        [
            "swecl.c",
            "swedate.c",
            "swehouse.c",
            "swejpl.c",
            "swemmoon.c",
            "swemplan.c",
            "sweph.c",
            "swephlib.c"
        ].join(" "),
        "swephp"
    );

    AC_DEFINE(
        "HAVE_SWEPHP",
        1,
        "Swiss Ephemeris PHP extension support"
    );
}